# YouTube Data API v3 OAuth desktop client.
# Copy this file to .env and set the path to your downloaded OAuth client JSON.
# Never commit .env, client secret files, access tokens, or refresh tokens.

YOUTUBE_CLIENT_SECRETS_FILE=client_secret_youtube.json

# Optional: change this if you use multiple Google Cloud projects/accounts.
YOUTUBE_TOKEN_KEY=default

# TikTok Desktop Login Kit / Content Posting API.
# Store the client secret from the app UI. It is saved in Windows Credential Manager.
TIKTOK_CLIENT_KEY=
TIKTOK_REDIRECT_URI=http://127.0.0.1:*/callback/
TIKTOK_TOKEN_KEY=default

# Cloudflare Workers AI image generation.
# Use a least-privilege API token with Workers AI permissions.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# OpenAI Story AI Provider.
# API usage is billed separately from ChatGPT subscriptions.
OPENAI_API_KEY=

# Gemini Story AI Provider.
# Keep Free-tier-only enabled unless you explicitly accept possible billing.
GEMINI_API_KEY=
